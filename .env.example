# API Configuration — point to FastAPI backend host (NO trailing /api — routers add it)
VITE_API_URL=http://localhost:8080

# Public SEO: leave blank/off until the new canonical domain is chosen.
# Only an HTTPS origin is accepted; no path, credentials, query, or fragment.
VITE_MARKETING_ORIGIN=
VITE_SITE_INDEXABLE=false
# Enable indexing only in the Vercel Production environment.
# Preview/Development deployments are always noindex regardless of this flag.

# Sentry (optional)
VITE_SENTRY_DSN=https://...@sentry.io/...

# Stripe (Phase 12e — implement last)
VITE_STRIPE_PUBLIC_KEY=pk_test_...

# Playwright e2e credentials.
# This file IS committed — never put real credentials here. Real values belong
# in .env.local (gitignored), which playwright.config.ts loads automatically.
TEST_USER_EMAIL=you@example.com
TEST_USER_PASSWORD=your-test-account-password